<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 236" width="100%" height="100%">
  <defs>
    <!-- Главный диагональный градиент фона (1 в 1 с терминалом) -->
    <linearGradient id="eq-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#02050b"/>
      <stop offset="45%" stop-color="#08162b"/>
      <stop offset="80%" stop-color="#112d55"/>
      <stop offset="100%" stop-color="#1b4982"/>
    </linearGradient>

    <!-- Мягкое внутреннее свечение -->
    <radialGradient id="center-glow" cx="55%" cy="55%" r="55%">
      <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.16"/>
      <stop offset="65%" stop-color="#1d4ed8" stop-opacity="0.05"/>
      <stop offset="100%" stop-color="#02050b" stop-opacity="0"/>
    </radialGradient>

    <!-- Градиентная рамка -->
    <linearGradient id="border-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1c2d45"/>
      <stop offset="50%" stop-color="#284975"/>
      <stop offset="100%" stop-color="#3a6ea8"/>
    </linearGradient>

    <!-- Вертикальный градиент для горящих пикселей эквалайзера -->
    <linearGradient id="pixel-grad" x1="0" y1="92" x2="0" y2="24" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#1d4ed8"/>
      <stop offset="45%" stop-color="#3b82f6"/>
      <stop offset="78%" stop-color="#7dd3fc"/>
      <stop offset="100%" stop-color="#eef8ff"/>
    </linearGradient>

    <!-- Ледяной градиент для заголовка MY ASSISTANTS -->
    <linearGradient id="title-grad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#eef6ff"/>
      <stop offset="100%" stop-color="#8cd2ff"/>
    </linearGradient>

    <!-- Паттерн потушенных пикселей (фоновая LED-сетка 54x10) -->
    <pattern id="unlit-grid" x="44" y="24" width="14" height="7" patternUnits="userSpaceOnUse">
      <rect x="0" y="0" width="10" height="5" fill="#040d1a" opacity="0.65"/>
    </pattern>

    <!-- Маска из 10 горизонтальных рядов для пиксельного эквалайзера -->
    <clipPath id="pixel-rows">
      <rect x="44" y="24" width="752" height="5"/>
