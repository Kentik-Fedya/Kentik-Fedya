  <defs>
    <!-- Главный диагональный градиент фона -->
    <linearGradient id="slab-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#02050b"/>
      <stop offset="45%" stop-color="#08162b"/>
      <stop offset="80%" stop-color="#112d55"/>
      <stop offset="100%" stop-color="#1b4982"/>
    </linearGradient>

    <!-- Мягкое внутреннее свечение -->
    <radialGradient id="center-glow" cx="60%" cy="50%" r="55%">
      <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.16"/>
      <stop offset="65%" stop-color="#1d4ed8" stop-opacity="0.05"/>
      <stop offset="100%" stop-color="#02050b" stop-opacity="0"/>
    </radialGradient>

    <!-- Градиентная рамка -->
    <linearGradient id="border-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1c2d45"/>
      <stop offset="50%" stop-color="#284975"/>
      <stop offset="100%" stop-color="#3a6ea8"/>
    </linearGradient>

    <!-- Ледяной градиент для заголовка -->
    <linearGradient id="title-grad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#eef6ff"/>
      <stop offset="100%" stop-color="#8cd2ff"/>
    </linearGradient>
  </defs>

  <style>
    .main-title {
      font-family: 'Monaco', 'Roboto Mono', 'Fira Code', 'JetBrains Mono', monospace;
      font-size: 18px;
      font-weight: 700;
      fill: url(#title-grad);
      letter-spacing: 1px;
    }
    .sub-title {
      font-family: 'Monaco', 'Roboto Mono', 'Fira Code', monospace;
      font-size: 11px;
      font-weight: 500;
      fill: #5c95e0;
      letter-spacing: 0.8px;
    }
    .icon-label {
      font-family: 'Monaco', 'Roboto Mono', 'Fira Code', monospace;
      font-size: 10.5px;
      font-weight: 600;
      fill: #9ac8ff;
      letter-spacing: 0.4px;
    }
    .pulse-dot {
      animation: softPulse 2.5s ease-in-out infinite;
    }
    /* Безопасная пиксельная CSS-анимация покачивания иконок */
    .bob1 { animation: pixelBob 2.4s steps(2, end) infinite 0s; }
    .bob2 { animation: pixelBob 2.4s steps(2, end) infinite -0.45s; }
    .bob3 { animation: pixelBob 2.4s steps(2, end) infinite -0.9s; }
    .bob4 { animation: pixelBob 2.4s steps(2, end) infinite -1.35s; }
    .bob5 { animation: pixelBob 2.4s steps(2, end) infinite -1.8s; }

    @keyframes pixelBob {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-3px); }
    }
    @keyframes softPulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }
  </style>

